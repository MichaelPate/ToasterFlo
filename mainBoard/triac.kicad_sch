			(justify left top)
		)
		(uuid "a3791dde-422a-40fd-979b-d46a300501f8")
	)
	(text_box "Per MOC3085 Datasheet:\nV_{F,LED}=1.4V @ I_{F}=20mA\nI_{FT}=5mA, I_{F,MAX}=50mA\n\nUse R_{5}=330Ω so I_{LED}=~15mA for\n5V IO from FET"
		(exclude_from_sim no)
		(at 307.34 49.53 0)
		(size 49.53 23.934)
