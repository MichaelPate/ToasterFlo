	(text_box "RC lowpass filter to remove most AC signals\nR = 10kΩ, C = 1 uF\n3dB rolloff f = (1 / (2*pi*R*C))\nf = (1 / (2*pi*10e3*1e-6)) = 15.92Hz"
		(exclude_from_sim no)
		(at 129.54 74.93 0)
